{
  "include": [
    "*.py"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/venv",
    "**/.venv",
    "**/env",
    "**/.env",
    "**/README.md",
    "**/*.md",
    "**/*.txt",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml"
  ],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.9",
  "typeCheckingMode": "basic"
}
